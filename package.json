{
  "$schema": "https://raw.githubusercontent.com/qwqnt-community/types/main/plugin.schema.json",
  "name": "qwqnt-hako",
  "version": "1.0.2",
  "description": "A plugin that provide basic features for QwQNT.",
  "type": "commonjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "oxlint --fix --tsconfig ./tsconfig.json --type-aware src",
    "build": "vite build --mode main && vite build --mode preload && vite build --mode renderer"
  },
  "author": "風間青祢",
  "license": "MIT",
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@qwqnt/types": "github:qwqnt-community/types",
    "@types/node": "^26.6.6",
    "electron": "^45.2.1",
    "lit": "^3.3.3",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "unplugin-oxlint": "^0.8.2",
    "unplugin-zip-pack": "^1.1.0",
    "vite": "^8.3.5",
    "vite-plugin-cp": "^8.0.1"
  },
  "packageManager": "pnpm@12.16.1",
  "qwqnt": {
    "name": "Hako",
    "inject": {
      "main": "./main/index.js",
      "preload": "./preload/index.js",
      "renderer": "./renderer/index.js"
    },
    "dependencies": {
      "qwqnt-ipc-interceptor": "^1.2.0"
    }
  }
}